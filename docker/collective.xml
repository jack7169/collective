<?xml version="1.0"?>
<Container version="2">
  <Name>Collective</Name>
  <Repository>ghcr.io/jackfranklin/collective</Repository>
  <Registry>https://github.com/jackfranklin/collective/pkgs/container/collective</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/jackfranklin/collective/issues</Support>
  <Project>https://github.com/jackfranklin/collective</Project>
  <Overview>Duplicate directory detection and consolidation tool. Find exact and similar folder structures across your storage array with percentage-based similarity scoring, Beyond Compare-style side-by-side visualization, and safe consolidation tools. Built for large Unraid arrays (17TB+).</Overview>
  <Category>Tools:Utilities Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/jackfranklin/collective/main/docker/collective.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/jackfranklin/collective/main/docs/icon.png</Icon>
  <ExtraParams>--memory=2g</ExtraParams>
  <Config Name="Web UI Port" Target="8080" Default="8080" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true"/>
  <Config Name="Config Storage" Target="/config" Default="/mnt/user/appdata/collective" Mode="rw" Description="Configuration, database, and scan cache storage" Type="Path" Display="always" Required="true"/>
  <Config Name="Data to Scan" Target="/data" Default="/mnt/user" Mode="ro" Description="Path to scan for duplicates (read-only by default)" Type="Path" Display="always" Required="true"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for file permissions" Type="Variable" Display="advanced"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID for file permissions" Type="Variable" Display="advanced"/>
  <Config Name="Default Scanner" Target="COLLECTIVE_SCANNER_DEFAULT" Default="rmlint" Mode="" Description="Default scanner engine (rmlint or fclones)" Type="Variable" Display="advanced"/>
  <Config Name="Similarity Threshold" Target="COLLECTIVE_SIMILARITY_THRESHOLD" Default="50" Mode="" Description="Minimum similarity % to report (0-100)" Type="Variable" Display="advanced"/>
</Container>
