# Collective Configuration
# Copy this to .env and adjust as needed

# Database connection (SQLite default)
COLLECTIVE_DATABASE_URL=sqlite+aiosqlite:///config/collective.db

# Directory for config files, database, and logs
COLLECTIVE_CONFIG_DIR=/data

# Root data directory for file browsing
COLLECTIVE_DATA_DIR=/data

# Comma-separated list of browsable root paths
COLLECTIVE_BROWSE_PATHS=/mnt/user

# Default scanner engine: "fclones" (fast, multi-threaded) or "rmlint" (directory detection)
COLLECTIVE_SCANNER_DEFAULT=fclones

# Default Jaccard similarity threshold for directory analysis (0-100)
COLLECTIVE_SIMILARITY_THRESHOLD=50.0

# Default directory depth for similarity grouping
COLLECTIVE_SCAN_DEPTH=3

# Logging level: DEBUG, INFO, WARNING, ERROR
COLLECTIVE_LOG_LEVEL=INFO

# Application environment: development or production
COLLECTIVE_ENV=production

# User/Group IDs for Unraid permission mapping
PUID=99
PGID=100
